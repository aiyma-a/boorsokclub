---
// Layered ridgelines, a nod to the Tian Shan. `hills` draws only the steppe curve.
const { variant = 'full' } = Astro.props;
---
<svg class="mountains" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
  {variant === 'full' && (
    <>
      <path d="M0 150 L140 70 L230 120 L360 30 L470 110 L560 80 L700 150 L820 60 L930 120 L1050 40 L1180 110 L1300 70 L1440 130 L1440 220 L0 220 Z" fill="#C9D2D6"/>
      <path d="M360 30 L395 58 L378 55 L360 70 L345 52 L330 56 Z M1050 40 L1082 66 L1066 63 L1050 76 L1036 60 L1022 64 Z" fill="#FAF8F3" opacity=".9"/>
      <path d="M0 175 L180 120 L320 165 L480 110 L640 170 L780 125 L960 175 L1120 120 L1280 165 L1440 140 L1440 220 L0 220 Z" fill="#A9B5BC"/>
    </>
  )}
  <path class="ground" d="M0 200 Q360 160 720 195 T1440 185 L1440 221 L0 221 Z" fill="#5B6A4E"/>
</svg>

<style>
  .mountains { display: block; width: 100%; height: clamp(90px, 14vw, 200px); margin-bottom: -1px; }
</style>
