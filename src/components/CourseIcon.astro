---
// Simple line icons for each course, drawn to match the tunduk logo.
const { slug, size = 40 } = Astro.props;
---
<svg viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
  {slug === 'tea-and-breakfast' && (<>
    <path d="M10 22 H38 Q38 36 24 36 Q10 36 10 22 Z" /><path d="M16 40 H32" />
    <path d="M19 16 Q17 13 19 10 M24 16 Q22 13 24 10 M29 16 Q27 13 29 10" />
  </>)}
  {slug === 'soups' && (<>
    <path d="M6 24 H42 Q40 38 24 38 Q8 38 6 24 Z" /><path d="M30 18 L40 8" />
    <path d="M14 18 Q13 15 15 12 M21 18 Q20 15 22 12" />
  </>)}
  {slug === 'mains' && (<>
    <path d="M8 22 H40 Q39 38 24 38 Q9 38 8 22 Z" /><path d="M5 22 H43" />
    <path d="M12 22 Q16 12 24 11 Q32 12 36 22" /><path d="M24 11 V8" />
  </>)}
  {slug === 'breads-and-pastries' && (<>
    <circle cx="24" cy="24" r="16" /><circle cx="24" cy="24" r="8" />
    <path d="M22 22 h.01 M26 22 h.01 M22 26 h.01 M26 26 h.01" stroke-width="3" />
  </>)}
  {slug === 'salads-and-sides' && (<>
    <path d="M8 26 H40 Q38 38 24 38 Q10 38 8 26 Z" />
    <path d="M16 26 Q14 16 22 14 Q22 22 18 26 M26 26 Q28 16 36 18 Q34 24 30 26" />
  </>)}
  {slug === 'sweets' && (<>
    <path d="M10 30 Q10 20 24 20 Q38 20 38 30 Z" /><path d="M8 30 H40 L37 36 H11 Z" />
    <circle cx="18" cy="15" r="3" /><circle cx="27" cy="12" r="3" />
  </>)}
  {slug === 'drinks' && (<>
    <path d="M14 12 H34 L31 38 H17 Z" /><path d="M15 20 H33" />
    <path d="M24 26 Q21 30 24 33 Q27 30 24 26 Z" />
  </>)}
</svg>
