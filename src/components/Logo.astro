---
import { u } from '../lib/url';
import BoorsokMark from './BoorsokMark.astro';
---
<a href={u("/")} class="logo" aria-label="Boorsok Club home">
  <BoorsokMark size={34} />
  <span>Boorsok Club</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: .5rem; text-decoration: none; color: var(--ink); }
  .logo span { font-family: var(--font-display); font-weight: 500; font-size: 1.3rem; white-space: nowrap; }
  @media (max-width: 420px) { .logo span { font-size: 1.1rem; } }
</style>
