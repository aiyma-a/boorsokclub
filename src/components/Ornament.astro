---
// A row of kochkor muiuz (ram's horn) motifs, drawn from the traditional form.
const { count = 7 } = Astro.props;
---
<div class="ornament" aria-hidden="true">
  <svg viewBox={`0 0 ${count * 48} 32`} width={count * 48} height="32">
    {Array.from({ length: count }, (_, i) => (
      <g transform={`translate(${i * 48 + 24} 18)`} fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round">
        <path d="M0 11 L0 0 C0 -10 -13 -13 -14 -4 C-15 2 -8 4 -7 -1" />
        <path d="M0 0 C0 -10 13 -13 14 -4 C15 2 8 4 7 -1" />
      </g>
    ))}
  </svg>
</div>

<style>
  .ornament { color: var(--red); display: flex; justify-content: center; margin: 2.5rem 0; overflow: hidden; }
  .ornament svg { max-width: 100%; height: auto; }
</style>
