---
// The Boorsok Club mark: a soft, puffed piece of boorsok.
// `mono` draws a line version in currentColor (for coloured backgrounds).
const { size = 32, mono = false } = Astro.props;
---
{mono ? (
  <svg class="boorsok-mark" viewBox="0 0 48 48" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
    <rect x="9" y="9" width="30" height="30" rx="11" transform="rotate(45 24 24)" />
    <path d="M15.5 21 Q24 14.5 32.5 21" />
    <path d="M19.5 27.5 Q24 30 28.5 27.5" />
  </svg>
) : (
  <svg class="boorsok-mark" viewBox="0 0 48 48" width={size} height={size} aria-hidden="true">
    <rect x="9" y="9" width="30" height="30" rx="11" transform="rotate(45 24 24)" fill="#EBC27A" />
    <path d="M15.5 21 Q24 14.5 32.5 21" fill="none" stroke="#F8E3B8" stroke-width="2.6" stroke-linecap="round" />
    <path d="M19.5 27.5 Q24 30 28.5 27.5" fill="none" stroke="#C99A4E" stroke-width="2.2" stroke-linecap="round" />
  </svg>
)}
