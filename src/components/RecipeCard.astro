---
import Placeholder from './Placeholder.astro';
const { recipe } = Astro.props;
const { title, description, image, imageAlt, region, prepMinutes, cookMinutes } = recipe.data;
---
<a class="card" href={`/recipes/${recipe.id}/`}>
  <div class="thumb">
    {image ? <img src={image} alt={imageAlt ?? title} loading="lazy" /> : <Placeholder label={title} />}
  </div>
  <div class="body">
    <p class="eyebrow">{region} · {prepMinutes + cookMinutes} min</p>
    <h3>{title}</h3>
    <p class="desc">{description}</p>
  </div>
</a>

<style>
  .card { display: block; background: var(--paper); border-radius: 18px; overflow: hidden; text-decoration: none; color: inherit; box-shadow: 0 1px 0 rgba(58,31,26,.08), 0 10px 30px -18px rgba(58,31,26,.4); transition: transform .2s ease; }
  .card:hover { transform: translateY(-3px); }
  .thumb { aspect-ratio: 4 / 5; background: var(--cream-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .body { padding: 1rem 1.15rem 1.3rem; }
  .eyebrow { margin: 0 0 .3rem; font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--teal); }
  h3 { margin: 0 0 .35rem; font-family: var(--font-display); font-size: 1.35rem; line-height: 1.15; }
  .desc { margin: 0; color: var(--ink-soft); font-size: .95rem; }
</style>
