---
import Placeholder from './Placeholder.astro';
const { recipe } = Astro.props;
const { title, description, image, imageAlt, region, prepMinutes, cookMinutes } = recipe.data;
---
<a class="card" href={`/recipes/${recipe.id}/`}>
  <div class="thumb">
    {image ? <img src={image} alt={imageAlt ?? title} loading="lazy" /> : <Placeholder label={title} course={recipe.data.course} />}
  </div>
  <p class="eyebrow">{region} · {prepMinutes + cookMinutes} min</p>
  <h3>{title}</h3>
  <p class="desc">{description}</p>
</a>

<style>
  .card { display: block; text-decoration: none; color: inherit; }
  .thumb { aspect-ratio: 4 / 5; border-radius: 14px; overflow: hidden; margin-bottom: .9rem; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s ease; }
  .card:hover img { transform: scale(1.03); }
  .card:hover h3 { color: var(--red); }
  h3 { margin: .25rem 0 .3rem; font-size: 1.35rem; transition: color .2s; }
  .desc { margin: 0; color: var(--ink-soft); font-size: .95rem; }
</style>
