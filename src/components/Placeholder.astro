---
// Shown until a real photo exists. Keeps layout honest without stock images.
const { label } = Astro.props;
---
<div class="ph" role="img" aria-label={`Photo coming soon: ${label}`}>
  <span>photo coming soon</span>
</div>

<style>
  .ph { width: 100%; height: 100%; min-height: 220px; display: grid; place-items: center;
    background:
      radial-gradient(circle at 50% 50%, transparent 0 38%, rgba(179,38,30,.08) 38% 40%, transparent 40%),
      repeating-linear-gradient(45deg, var(--cream-2) 0 14px, #EFDFC2 14px 28px); }
  span { font-weight: 800; font-size: .8rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-soft); background: var(--paper); padding: .4rem .75rem; border-radius: 999px; }
</style>
