---
// Shown until a real photo exists: a warm tint of the recipe's course colour.
import CourseIcon from './CourseIcon.astro';
import { courses } from '../data/menu';
const { label, course } = Astro.props;
const color = courses.find((c) => c.slug === course)?.color ?? '#D8C9B0';
---
<div class="ph" role="img" aria-label={`Photo coming soon: ${label}`} style={`--c: ${color}`}>
  <CourseIcon slug={course} size={64} />
  <span>photo coming soon</span>
</div>

<style>
  .ph { width: 100%; height: 100%; min-height: 200px; display: grid; place-content: center; justify-items: center; gap: .8rem;
    background: radial-gradient(120% 90% at 30% 20%, color-mix(in srgb, var(--c) 35%, #fff) 0%, color-mix(in srgb, var(--c) 70%, #fff) 100%);
    color: color-mix(in srgb, var(--c) 45%, #2E2B27); }
  span { font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
</style>
