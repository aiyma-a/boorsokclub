---
// Shown until a real photo exists.
const { label } = Astro.props;
---
<div class="ph" role="img" aria-label={`Photo coming soon: ${label}`}>
  <span>photo coming soon</span>
</div>

<style>
  .ph { width: 100%; height: 100%; min-height: 200px; display: grid; place-items: center; background: linear-gradient(180deg, #E7ECEC 0%, #EFEBE2 100%); }
  span { font-size: .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); }
</style>
