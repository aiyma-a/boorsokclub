---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import { occasions } from '../../data/menu';
---
<Base title="Occasions" description="Central Asian recipes for guests, Nooruz, celebrations and every day.">
  <section class="wrap">
    <header class="head">
      <p class="eyebrow">Occasions</p>
      <h1>Cook for the moment</h1>
      <p class="blurb">In Central Asia, what's on the table depends on who's around it. Pick the occasion.</p>
    </header>
    <div class="list">
      {occasions.map((o) => (
        <a class="occ" href={u(`/occasions/${o.slug}/`)}>
          <h2>{o.label}</h2>
          <p>{o.blurb}</p>
          <span>See recipes →</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .head { max-width: 620px; margin: 2.8rem 0 2rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); margin: .5rem 0 .6rem; }
  .blurb { color: var(--ink-soft); font-size: 1.1rem; margin: 0; }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; }
  .occ { display: block; padding: 1.5rem; background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--red); border-radius: 14px; text-decoration: none; color: var(--ink); }
  .occ:hover { border-color: var(--ink); border-top-color: var(--red); }
  .occ h2 { font-size: 1.4rem; margin: 0 0 .4rem; }
  .occ p { margin: 0 0 1rem; color: var(--ink-soft); font-size: .95rem; }
  .occ span { font-weight: 700; font-size: .9rem; color: var(--red); }
</style>
