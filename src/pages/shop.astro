---
import Base from '../layouts/Base.astro';
---
<Base title="Sticker Shop" description="Food stickers inspired by Central Asian cooking, coming soon to Boorsok Club.">
  <section class="prose shop">
    <svg class="mark" viewBox="0 0 32 32" width="56" height="56" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <circle cx="16" cy="16" r="12"/>
      <path d="M10 8.5 L22 23.5 M22 8.5 L10 23.5 M16 4 L16 28"/>
    </svg>
    <p class="eyebrow">Sticker Shop · Coming soon</p>
    <h1>Stickers from our kitchen, coming soon</h1>
    <p class="blurb">Our first set of food stickers, inspired by the dishes on this site, is in the works.</p>
    <ul class="facts">
      <li>Original designs, drawn by us</li>
      <li>Inspired by Central Asian food and craft</li>
      <li>Shipping and returns details posted before launch</li>
    </ul>
    <a class="btn" href="/recipes/">Browse recipes while you wait</a>
    <!-- TODO: add "Follow us on Pinterest" link once the account exists -->
  </section>
</Base>

<style>
  .shop { text-align: center; padding-top: clamp(3rem, 8vw, 5.5rem); }
  .mark { color: var(--red); margin-bottom: 1rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: .6rem 0 .8rem; }
  .blurb { color: var(--ink-soft); font-size: 1.15rem; margin: 0 auto 1.8rem; max-width: 520px; }
  .facts { list-style: none; padding: 1.2rem 0; margin: 0 auto 2rem; max-width: 420px; display: grid; gap: .5rem; border-block: 1px solid var(--line); }
  .facts li::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--red); margin-right: .6rem; vertical-align: 2px; }
</style>
