---
import { getCollection } from 'astro:content';
import CategoryPage from '../../components/CategoryPage.astro';
import { courses } from '../../data/menu';

const recipes = (await getCollection('recipes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const chips = [{ href: '/recipes/', label: 'All', active: true }, ...courses.map((c) => ({ href: `/recipes/course/${c.slug}/`, label: c.label }))];
---
<CategoryPage eyebrow="Recipes" title="All recipes" blurb="Kyrgyz and Central Asian dishes for home cooks, from a pot of tea to a wedding feast." recipes={recipes} chips={chips} />
