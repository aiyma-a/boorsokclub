---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RecipeCard from '../../components/RecipeCard.astro';

const recipes = (await getCollection('recipes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Recipes" description="All Boorsok Club recipes: Kyrgyz and Central Asian dishes for home cooks.">
  <section class="wrap">
    <h1>All recipes</h1>
    <div class="grid">{recipes.map((r) => <RecipeCard recipe={r} />)}</div>
  </section>
</Base>

<style>
  h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); margin: 2.5rem 0 1.5rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; }
</style>
