---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { id: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
const d = recipe.data;
const { Content } = await render(recipe);
const url = new URL(`/recipes/${recipe.id}/`, Astro.site).href;
const imageUrl = d.image ? new URL(d.image, Astro.site).href : undefined;

// schema.org Recipe: what Pinterest Rich Pins and Google recipe results read.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.title,
  description: d.description,
  image: imageUrl ? [imageUrl] : undefined,
  author: { '@type': 'Organization', name: 'Boorsok Club' },
  datePublished: d.date.toISOString().slice(0, 10),
  prepTime: `PT${d.prepMinutes}M`,
  cookTime: `PT${d.cookMinutes}M`,
  totalTime: `PT${d.prepMinutes + d.cookMinutes}M`,
  recipeYield: d.servings,
  recipeCuisine: d.region,
  keywords: d.tags.join(', '),
  recipeIngredient: d.ingredients,
  recipeInstructions: d.steps.map((text) => ({ '@type': 'HowToStep', text })),
};

// Plain share link: no Pinterest script, so no third-party tracking on page load.
const pinHref = `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(url)}&description=${encodeURIComponent(d.title)}${imageUrl ? `&media=${encodeURIComponent(imageUrl)}` : ''}`;
---
<Base title={d.title} description={d.description} image={d.image} type="article" jsonLd={jsonLd}>
  <article>
    <header class="hero wrap">
      <div class="intro">
        <p class="eyebrow">{d.region}</p>
        <h1>{d.title}</h1>
        <p class="lede">{d.description}</p>
        <div class="actions">
          <a class="btn" href="#recipe">Jump to recipe ↓</a>
          <a class="btn ghost" href={pinHref} target="_blank" rel="noopener">Save to Pinterest</a>
        </div>
      </div>
      <div class="photo">
        {d.image ? <img src={d.image} alt={d.imageAlt ?? d.title} /> : <Placeholder label={d.title} />}
      </div>
    </header>

    <div class="prose story">
      <Content />
    </div>

    <hr class="divider" />

    <section id="recipe" class="recipe-card prose" aria-labelledby="card-title">
      <div class="card-head">
        <h2 id="card-title">{d.title}</h2>
        <button class="btn ghost print" type="button" onclick="window.print()">Print recipe</button>
      </div>
      <dl class="facts">
        <div><dt>Prep</dt><dd>{d.prepMinutes} min</dd></div>
        <div><dt>Cook</dt><dd>{d.cookMinutes} min</dd></div>
        <div><dt>Total</dt><dd>{d.prepMinutes + d.cookMinutes} min</dd></div>
        <div><dt>Makes</dt><dd>{d.servings}</dd></div>
      </dl>
      {d.allergens.length > 0 && (
        <p class="allergens"><strong>Contains</strong> · {d.allergens.join(', ')}</p>
      )}
      <div class="cols">
        <div>
          <h3>Ingredients</h3>
          <ul class="ingredients">{d.ingredients.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div>
          <h3>Method</h3>
          <ol class="steps">{d.steps.map((s) => <li>{s}</li>)}</ol>
        </div>
      </div>
      <p class="note">Times and yields are a guide. Allergen notes cover common allergens only, so always check your own ingredient labels.</p>
    </section>
  </article>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 5vw, 4rem); align-items: center; padding-block: clamp(2rem, 6vw, 4rem) 3rem; }
  h1 { font-size: clamp(2.4rem, 6vw, 3.8rem); margin: .5rem 0 1rem; }
  .lede { font-size: 1.15rem; color: var(--ink-soft); margin: 0 0 1.8rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .photo { aspect-ratio: 4 / 5; border-radius: 18px; overflow: hidden; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .story { font-size: 1.1rem; }
  .story :global(h2) { font-size: 1.6rem; margin-top: 2.2rem; }
  .divider { border: 0; border-top: 1px solid var(--line); width: min(100% - 2.5rem, 680px); margin: 3.5rem auto; }
  .recipe-card { border: 1px solid var(--line); border-radius: 18px; padding: clamp(1.25rem, 4vw, 2.5rem); background: #fff; scroll-margin-top: 90px; }
  .card-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .card-head h2 { margin: 0; font-size: 1.9rem; }
  .facts { display: flex; flex-wrap: wrap; gap: .5rem 2rem; margin: 1.3rem 0; padding: 1rem 0; border-block: 1px solid var(--line); }
  dt { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--sage); }
  dd { margin: 0; font-weight: 700; }
  .allergens { font-size: .95rem; color: var(--ink-soft); margin: 0 0 1.5rem; }
  .allergens strong { color: var(--apricot); }
  .cols { display: grid; grid-template-columns: .85fr 1.15fr; gap: 2.5rem; }
  h3 { font-size: 1.25rem; margin: 0 0 .8rem; }
  .ingredients { list-style: none; padding: 0; margin: 0; }
  .ingredients li { padding: .45rem 0; border-bottom: 1px dashed var(--line); }
  .steps { padding-left: 1.3rem; margin: 0; }
  .steps li { margin-bottom: .9rem; padding-left: .4rem; }
  .steps li::marker { font-family: var(--font-display); color: var(--lake); }
  .note { font-size: .85rem; color: var(--ink-soft); margin: 1.5rem 0 0; }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; }
    .photo { order: -1; aspect-ratio: 4 / 3; }
    .cols { grid-template-columns: 1fr; gap: 1.5rem; }
  }
  @media print {
    .hero, .story, .divider, .print { display: none !important; }
    .recipe-card { border: 0; padding: 0; }
  }
</style>
